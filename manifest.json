{
  "manifest_version": 3,
  "name": "Facebook Reel Saver",
  "version": "1.0.0",
  "description": "Right-click on Facebook reels to save their links to a text file",
  "permissions": [
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Facebook Reel Saver"
  }
}
